{
  "name": "theme-marketplace-backend",
  "version": "1.0.0",
  "description": "Backend API for Digital Theme Marketplace (Vietnam & Global) - MVC Architecture",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit",
    "test": "tsx tests/run_all_tests.ts",
    "test:all": "tsx tests/run_all_tests.ts",
    "test:member2": "tsx tests/member2_auth_catalog.test.ts",
    "test:oauth": "tsx tests/oauth.test.ts",
    "test:member3": "tsx tests/member3_payment_licensing.test.ts",
    "test:member5": "tsx tests/member5_checkout.test.ts",
    "test:admin": "npm run build && node tests/admin-bootstrap.test.mjs && node tests/admin-auth.test.mjs && node tests/admin.api.test.mjs",
    "admin:create": "npm run build && node scripts/create-initial-admin.mjs",
    "db:migrate": "node ../database/migrations/migrate.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
