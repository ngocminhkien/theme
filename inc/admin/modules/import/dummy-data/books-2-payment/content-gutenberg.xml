<!-- wp:wd/column {"blockId":"8f28470e-15be-4c9f-bd43-1600b73ea1e1","blockVersion":"2","adjacentCount":2,"colWidth":85,"adjacentCountTablet":2,"colWidthTablet":70} -->
<div class="wp-block-wd-column wd-8f28470e"><!-- wp:wd/title {"blockId":"5699d500-ed1f-4aec-aa38-47a28224b3dd","blockVersion":"2","content":"Accepted Payment Methods","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-5699d500">Accepted Payment Methods</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"12787e79-643b-4066-ab2a-fc3d9d7ff29c","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-12787e79">We accept a variety of secure payment options for your convenience:</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/list {"blockId":"0216e498-67f4-4dd0-ba16-077475b9d3d7","blockVersion":"2","iconType":"unordered-2","marginBottom":"20"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-0216e498"><!-- wp:wd/list-item {"blockId":"4b416a83-dec4-4ccb-a089-5a88e748423f","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-4b416a83"><div class="wd-icon"></div><span class="wd-list-content">Visa</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"953f2f87-9735-421a-b573-62b1fb8c0361","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-953f2f87"><div class="wd-icon"></div><span class="wd-list-content">Mastercard</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"9172c53d-b72d-4c39-a7fe-26780c83b815","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-9172c53d"><div class="wd-icon"></div><span class="wd-list-content">PayPal</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"25b0d0f4-41ef-4f07-a6ed-17ccf3aed83a","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-25b0d0f4"><div class="wd-icon"></div><span class="wd-list-content">Apple Pay</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"bd62e232-d9ae-4ae6-a67a-afd02053deef","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-bd62e232"><div class="wd-icon"></div><span class="wd-list-content">Google Pay</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list -->

<!-- wp:wd/title {"blockId":"f55b2883-ac6e-47e4-bcb6-6d0b4c64f7be","blockVersion":"2","content":"Payment Security","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-f55b2883">Payment Security</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/list {"blockId":"0cd2fddf-dc0d-43a0-a57c-2e45434b1592","blockVersion":"2","iconType":"unordered-2","marginBottom":"20"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-0cd2fddf"><!-- wp:wd/list-item {"blockId":"3643c0b0-9bde-4c1f-8fe1-0a5b33d7b26c","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-3643c0b0"><div class="wd-icon"></div><span class="wd-list-content">All transactions are processed through a secure, encrypted connection to protect your personal and financial information.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"0666d7bd-f755-4ae2-a049-b0b2456c4556","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-0666d7bd"><div class="wd-icon"></div><span class="wd-list-content">Your credit card details are never stored on our servers.</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list -->

<!-- wp:wd/title {"blockId":"6cd96473-bc91-4ec7-9938-7c1a1728cbe0","blockVersion":"2","content":"When You're Charged","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-6cd96473">When You're Charged</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/list {"blockId":"c76298f4-94dc-46d3-815b-49a16d01352c","blockVersion":"2","iconType":"unordered-2","marginBottom":"20"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-c76298f4"><!-- wp:wd/list-item {"blockId":"fe798946-b9ec-4d7d-9cf9-cc0980ef6b06","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-fe798946"><div class="wd-icon"></div><span class="wd-list-content">Your card will be charged at the time of purchase.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"615474d3-20c2-4b1b-bc90-6d5111db629c","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-615474d3"><div class="wd-icon"></div><span class="wd-list-content">If an item in your order is out of stock, you will not be charged for that item, or a refund will be issued promptly if a charge occurred.</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list -->

<!-- wp:wd/title {"blockId":"4617fd67-11f8-41ae-b4d3-247f5df8a2d6","blockVersion":"2","content":"Sales Tax","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-4617fd67">Sales Tax</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"93cbecb2-93a5-4754-8d7e-b2722f1ebc50","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-93cbecb2">Sales tax will be applied to orders shipped to addresses in the following states, in accordance with state and local tax laws:</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/list {"blockId":"7c4969a3-cbd4-4b95-9993-ac08d1ed4be1","blockVersion":"2","iconType":"unordered-2"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-7c4969a3"><!-- wp:wd/list-item {"blockId":"5e0c0cc1-405c-4af6-962c-d1acb216aee5","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-5e0c0cc1"><div class="wd-icon"></div><span class="wd-list-content"><strong>California (CA):</strong> As required by law, sales tax is collected on all applicable purchases shipped within California.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"de9f0ec3-2623-4383-82e0-7e634b7d74d1","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-de9f0ec3"><div class="wd-icon"></div><span class="wd-list-content"><strong>New York (NY):</strong> Sales tax is applied to orders delivered to New York addresses.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"2b881ab4-6ea2-4a2b-9986-d851ce4bc77d","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-2b881ab4"><div class="wd-icon"></div><span class="wd-list-content"><strong>Texas (TX):</strong> Orders shipped to Texas are subject to the appropriate state and local sales tax rates.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"8a56a41e-c359-4261-ad58-f252030e14cc","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-8a56a41e"><div class="wd-icon"></div><span class="wd-list-content"><strong>Florida (FL):</strong> Sales tax is collected on taxable items shipped to Florida addresses.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"aa4f3023-6c7b-4c0c-b27b-ea1c83419bcb","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-aa4f3023"><div class="wd-icon"></div><span class="wd-list-content"><strong>Illinois (IL):</strong> Orders destined for Illinois will have sales tax calculated and added at checkout.</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list -->

<!-- wp:wd/paragraph {"blockId":"50defc07-c4e2-4d81-9be5-f366e1616c45","blockVersion":"2","colorCode":"#767676","marginBottom":"20"} -->
<p class="wp-block-wd-paragraph wd-50defc07"><em>*The exact tax rate will be calculated at checkout based on your specific shipping address.</em></p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/title {"blockId":"9d0b8be6-28a8-4718-9cee-3711412377a8","blockVersion":"2","content":"Payment Issues","tpFontSize":"28"} -->
<h2 class="wp-block-wd-title title wd-9d0b8be6">Payment Issues</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/list {"blockId":"457d3aeb-d1e6-4418-bd36-75a00bbf713b","blockVersion":"2","iconType":"unordered-2","marginBottom":"20"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-457d3aeb"><!-- wp:wd/list-item {"blockId":"d47b9694-8156-4bb3-bde2-44e29607ac49","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-d47b9694"><div class="wd-icon"></div><span class="wd-list-content">Once your order has shipped, you will receive a confirmation email with a tracking number.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"47f30ef4-5ff0-4d0a-bcac-4e44c793660b","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-47f30ef4"><div class="wd-icon"></div><span class="wd-list-content">You can track your order's progress by clicking the link in the email or by visiting the "Order Status" section on our website.</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list -->

<!-- wp:wd/title {"blockId":"bdfaf1c5-5c6b-4306-9a21-f15e0c39e1f4","blockVersion":"2","content":"Delivery Issues","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-bdfaf1c5">Delivery Issues</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/list {"blockId":"8ebe9d2f-4ee7-43c7-817f-fddaf2082813","blockVersion":"2","iconType":"unordered-2"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-8ebe9d2f"><!-- wp:wd/list-item {"blockId":"e195f7cf-2563-4d7f-a452-e7956b1c5b17","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-e195f7cf"><div class="wd-icon"></div><span class="wd-list-content">If you experience any issues with your payment, please double-check your card details, billing address, and ensure sufficient funds are available.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"accad3a9-9355-4f6b-8e1e-fb4d291470da","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-accad3a9"><div class="wd-icon"></div><span class="wd-list-content">If problems persist, please contact your bank or payment provider, or reach out to our Customer Service team for assistance.</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list --></div>
<!-- /wp:wd/column --></div>
<!-- /wp:wd/row -->]]></content:encoded>
