<h2 class="wp-block-wd-title title wd-41d9819b">+1 million</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"75e652d5-3bc2-44aa-a269-e4ce2fbb873c","blockVersion":"2","tpFontSize":"18","tpFontSizeTablet":"16"} -->
<p class="wp-block-wd-paragraph wd-75e652d5">customers every year</p>
<!-- /wp:wd/paragraph --></div>
<!-- /wp:wd/column -->

<!-- wp:wd/column {"blockId":"5a704584-ed87-4df0-a873-742b1af52c87","blockVersion":"2","adjacentCount":4,"colWidth":25,"blocksGap":10,"textAlign":"center","bgColorCode":"#ffffff","paddingTop":"30","paddingRight":"30","paddingBottom":"30","paddingLeft":"30","paddingLock":true,"borderRadius":"20","borderRadiusTop":"20","borderRadiusRight":"20","borderRadiusBottom":"20","borderRadiusLeft":"20","adjacentCountMobile":1,"colWidthMobile":100} -->
