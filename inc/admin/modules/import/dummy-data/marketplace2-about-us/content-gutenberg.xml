<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"9e66d85c-2de2-4bf5-8a9b-4e5fb1ae7e56","blockVersion":"2","tpFontSize":"18","tpFontSizeTablet":"16"} -->
<p class="wp-block-wd-paragraph wd-9e66d85c">of total income</p>
<!-- /wp:wd/paragraph --></div>
<!-- /wp:wd/column -->

<!-- wp:wd/column {"blockId":"0f55dae1-606a-4f55-9935-e8b0370ba3b2","blockVersion":"2","adjacentCount":4,"colWidth":25,"blocksGap":10,"textAlign":"center","bgColorCode":"#ffffff","paddingTop":"30","paddingRight":"30","paddingBottom":"30","paddingLeft":"30","paddingLock":true,"borderRadius":"20","borderRadiusTop":"20","borderRadiusRight":"20","borderRadiusBottom":"20","borderRadiusLeft":"20","adjacentCountMobile":2,"colWidthMobile":100} -->
