<h2 class="wp-block-wd-title title wd-3cecb632">400+ </h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"7b4eadeb-bfcc-4345-90fa-4683fb3cb23b","blockVersion":"2","tpFontSize":"18","tpFontSizeTablet":"16"} -->
<p class="wp-block-wd-paragraph wd-7b4eadeb">employees worldwide</p>
<!-- /wp:wd/paragraph --></div>
<!-- /wp:wd/column -->

<!-- wp:wd/column {"blockId":"3e0d71f3-4287-4353-8b4f-abb5829f8231","blockVersion":"2","adjacentCount":4,"colWidth":25,"blocksGap":10,"textAlign":"center","bgColorCode":"#ffffff","paddingTop":"30","paddingRight":"30","paddingBottom":"30","paddingLeft":"30","paddingLock":true,"borderRadius":"20","borderRadiusTop":"20","borderRadiusRight":"20","borderRadiusBottom":"20","borderRadiusLeft":"20","adjacentCountMobile":1,"colWidthMobile":100} -->
<div class="wp-block-wd-column wd-align wd-3e0d71f3"><!-- wp:wd/title {"blockId":"039a5d56-4efd-4ca5-bdc2-e22af6d36fe4","blockVersion":"2","content":"100%","tpFontSize":"30","tpLineHeight":"1.2","colorVariable":"\u002d\u002dwd-primary-color","tpFontSizeTablet":"24","tpFontSizeMobile":"22","tpLineHeightUnits":"em"} -->
<h2 class="wp-block-wd-title title wd-039a5d56">100%</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"779bd8d4-79a7-445c-b782-08d5fc4f3d97","blockVersion":"2","tpFontSize":"18","tpFontSizeTablet":"16"} -->
<p class="wp-block-wd-paragraph wd-779bd8d4">founder owned</p>
<!-- /wp:wd/paragraph --></div>
<!-- /wp:wd/column --></div>
<!-- /wp:wd/row -->

<!-- wp:wd/paragraph {"blockId":"c071b907-0715-4862-83a4-c500c33432c2","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-c071b907">We are firm believers that life's conveniences, joys, and kindness should be easily attainable. Hence, the quest for these should be swift, user-friendly, and delightful. At Woodmart, our commitment goes beyond selling home appliances, electronics, jewelry, or wine. We strive to streamline your search, ensuring you find precisely what you need effortlessly. Our aim is to eliminate the hassle of endless searches, allowing you to live a content and joyful life. Woodmart serves as a comprehensive solution, from the initiation to the culmination of your search, a genuine companion. We liberate our customers from unwelcome compromises, fulfill their desires, and empower them to dream without constraints. Through intelligent search mechanisms and sincere service, we're actively enhancing our customers' lives, one step at a time.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/gallery {"blockId":"a279892a-f4df-4f4d-9c55-809355f4a61c","blockVersion":"2","layout":"carousel","paginationControl":false,"paginationControlTablet":false,"paginationControlMobile":false,"syncParentId":"wd_a279892a","marginBottom":"20"} -->
