<h2 class="wp-block-wd-title title wd-c9d481f9 wd-custom-width">Founded with a passion for creativity, authenticity, and modern elegance, we believe style should feel effortless and personal.</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/image {"blockId":"2b238f42-cc45-439a-aa22-f57e67c58cb4","blockVersion":"2","image":{"id":499,"url":"http://dummy.xtemos.com/woodmart2/fashion-2-gutenberg/wp-content/uploads/sites/70/2026/02/fs-ab-us-1-opt.jpg","width":1800,"height":810},"imageData":{"url":"https://dummy.xtemos.com/woodmart2/fashion-2-gutenberg/wp-content/uploads/sites/70/2026/02/fs-ab-us-1-opt.jpg","width":1800,"height":810},"marginBottom":"80","marginBottomTablet":"60","marginBottomMobile":"40"} -->
