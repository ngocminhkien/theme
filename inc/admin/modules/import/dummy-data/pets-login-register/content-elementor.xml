											<content:encoded><![CDATA[<h2>My account</h2>				
								<link rel="stylesheet" id="wd-woo-el-notices-builder-css" href="https://dummy.xtemos.com/woodmart2/pets-elementor/wp-content/themes/woodmart/css/parts/woo-el-notices-builder.css?ver=8.5.0" type="text/css" media="all" /> 							
								<link rel="stylesheet" id="wd-woo-mod-login-form-css" href="https://dummy.xtemos.com/woodmart2/pets-elementor/wp-content/themes/woodmart/css/parts/woo-mod-login-form.css?ver=8.5.0" type="text/css" media="all" /> 			<h2>Login</h2>					<form method="post" action="https://dummy.xtemos.com/woodmart2/pets-elementor/my-account/?action=login">
				<p>
					<label for="username">Username or email address&nbsp;*Required</label>
					<input type="text" name="username" id="username" autocomplete="username" value="" />				</p>
				<p>
					<label for="password">Password&nbsp;*Required</label>
					<input type="password" name="password" id="password" autocomplete="current-password" />
				</p>
				<p>
					<input type="hidden" id="woocommerce-login-nonce" name="woocommerce-login-nonce" value="df6dcf5f30" /><input type="hidden" name="_wp_http_referer" value="/woodmart2/pets-elementor/wp-admin/admin-ajax.php" />										<button type="submit" name="login" value="Log in">Log in</button>
				</p>
				<p>
					<a href="https://dummy.xtemos.com/woodmart2/pets-elementor/my-account/lost-password/">Lost your password?</a>
					<label>
						<input name="rememberme" type="checkbox" value="forever" title="Remember me" aria-label="Remember me" /> Remember me
					</label>
				</p>
							</form>
					<h2>Register</h2>]]></content:encoded>
