<!-- wp:wd/accordion-pane {"blockId":"ffd1c80c-74a2-49b3-ba70-cbaf3c4ca6e6"} -->
<div id="wd-ffd1c80c" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>Do you host events or live performances at your store?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"06e7df84-6503-4325-a1e1-f21bfaaea76f"} -->
<p id="wd-06e7df84" class="wp-block-wd-paragraph">If the contents of the parcel are suspicious to customs officers (for example, many identical goods), it may be further checked.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane -->

<!-- wp:wd/accordion-pane {"blockId":"14e5407b-f466-4021-b887-4e31fd71a1bd"} -->
<div id="wd-14e5407b" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>Do you ship vinyl records internationally?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"a339f8d6-beeb-43a2-a66a-efa93cd7c095"} -->
<p id="wd-a339f8d6" class="wp-block-wd-paragraph">Keep the product in its original packaging along with all documents confirming the purchase and refund. You will need this for further communication with the seller and the payment system.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane --></div>
