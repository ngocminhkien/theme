<h2 class="wp-block-wd-title title wd-1cb54b2a">Do you want to become our Vendor?</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"3b0822f8-fb1d-4e05-b045-a8062cade64d","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-3b0822f8">We are always looking for interesting people with interesting ideas! We value a flat hierarchy, clear communication, full ownership and responsibility.</p>
<!-- /wp:wd/paragraph -->

