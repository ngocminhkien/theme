<!-- wp:wd/column {"blockId":"8f28470e-15be-4c9f-bd43-1600b73ea1e1","blockVersion":"2","adjacentCount":2,"colWidth":85,"adjacentCountTablet":2,"colWidthTablet":70} -->
<div class="wp-block-wd-column wd-8f28470e"><!-- wp:wd/title {"blockId":"50ccf75b-c514-4efb-acea-358bffb4e17f","blockVersion":"2","content":"Our Story","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-50ccf75b">Our Story</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"d1ee5944-5dee-4e12-9467-973a944e51ce","blockVersion":"2","marginBottom":"20"} -->
<p class="wp-block-wd-paragraph wd-d1ee5944">WoodMart Books was founded in 2017 with a simple yet profound vision: to create a place where everyone could find their next great read. What started as a small dream, fueled by a lifelong passion for books, has blossomed into the beloved establishment you see today. We believe in the power of stories to connect, inspire, and transform, and we've dedicated ourselves to curating a collection that reflects the rich tapestry of human experience.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/gallery {"blockId":"9db6e954-c52c-4415-a248-2b85fc8d22eb","blockVersion":"2","columns":2,"size":"aspectRatio","marginBottom":"20","displayWidth":""} -->
<div class="wp-block-wd-gallery wd-grid-g wd-caption-mask wd-9db6e954" style="--wd-col-lg:2;--wd-col-md:2;--wd-col-sm:1;--wd-gap-lg:20px;--wd-gap-sm: 10px"><!-- wp:wd/gallery-item {"blockId":"ed1c93eb-7c5e-4cb6-95bb-b88955c731dc","blockVersion":"2","image":{"id":13,"url":"http://dummy.xtemos.com/woodmart2/books-2-gutenberg/wp-content/uploads/sites/88/2026/07/bk2-about-us-img-1.jpg"},"imageData":{"url":"http://dummy.xtemos.com/woodmart2/books-2-gutenberg/wp-content/uploads/sites/88/2026/07/bk2-about-us-img-1.jpg","width":651,"height":430}} -->
<div class="wp-block-wd-gallery-item wd-col wd-ed1c93eb"><div class="wd-block-image"><img class="wp-image-13" src="http://dummy.xtemos.com/woodmart2/books-2-gutenberg/wp-content/uploads/sites/88/2026/07/bk2-about-us-img-1.jpg" alt="" /></div></div>
<!-- /wp:wd/gallery-item -->

<!-- wp:wd/gallery-item {"blockId":"d05c3856-77bb-4398-8d0f-ce96a3d347cb","blockVersion":"2","image":{"id":14,"url":"http://dummy.xtemos.com/woodmart2/books-2-gutenberg/wp-content/uploads/sites/88/2026/07/bk2-about-us-img-2.jpg"},"imageData":{"url":"http://dummy.xtemos.com/woodmart2/books-2-gutenberg/wp-content/uploads/sites/88/2026/07/bk2-about-us-img-2.jpg","width":651,"height":430}} -->
<div class="wp-block-wd-gallery-item wd-col wd-d05c3856"><div class="wd-block-image"><img class="wp-image-14" src="http://dummy.xtemos.com/woodmart2/books-2-gutenberg/wp-content/uploads/sites/88/2026/07/bk2-about-us-img-2.jpg" alt="" /></div></div>
<!-- /wp:wd/gallery-item --></div>
<!-- /wp:wd/gallery -->

<!-- wp:wd/title {"blockId":"0bc50313-018f-402f-9896-738ef9e1b2f4","blockVersion":"2","content":"Our Mission","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-0bc50313">Our Mission</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"cbccefb1-a38b-46ff-835a-24971477bdc6","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-cbccefb1">We believe that books have the power to transport, inspire, educate, and connect. Our mission is to:</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/list {"blockId":"a5287b10-ae74-47e1-a9d2-717374d5353e","blockVersion":"2","iconType":"unordered-2","marginBottom":"20"} -->
<ul class="wp-block-wd-list wd-list wd-type-unordered-2 wd-a5287b10"><!-- wp:wd/list-item {"blockId":"9beaffbb-5777-4c59-ac11-455d0ce39e4b","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-9beaffbb"><div class="wd-icon"></div><span class="wd-list-content"><strong>Ignite Imaginations:</strong> Provide a diverse and captivating collection of books that sparks curiosity and encourages exploration.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"2bb429f6-5606-498e-86d4-bbce9ce0b2c4","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-2bb429f6"><div class="wd-icon"></div><span class="wd-list-content"><strong>Build Community:</strong> Create a warm and inviting atmosphere where readers can gather, share ideas, and connect with fellow book lovers.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"f52b82a8-d907-4b5b-aa8d-e8f4ba3461f3","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-f52b82a8"><div class="wd-icon"></div><span class="wd-list-content"><strong>Support Authors:</strong> Champion both established and emerging authors, giving a platform to diverse voices and stories.</span></li>
<!-- /wp:wd/list-item -->

<!-- wp:wd/list-item {"blockId":"a1f11c8d-d9a4-4b8a-b5c9-8db812646a7d","blockVersion":"2","iconType":"unordered-2","svg":"","image":""} -->
<li class="wp-block-wd-list-item wd-a1f11c8d"><div class="wd-icon"></div><span class="wd-list-content"><strong>Promote Literacy: </strong>Encourage reading at all stages of life, from early childhood literacy to lifelong learning.</span></li>
<!-- /wp:wd/list-item --></ul>
<!-- /wp:wd/list -->

<!-- wp:wd/title {"blockId":"fb3a02ba-6acc-4975-883b-2a49f78aaaf9","blockVersion":"2","content":"Join Our Story","tpFontSize":"28","htmlTag":"h2"} -->
<h2 class="wp-block-wd-title title wd-fb3a02ba">Join Our Story</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"3cb7d12a-be4a-4f3c-9011-40e6532ba341","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-3cb7d12a">We are more than just a bookstore; we are a place where stories come alive, where ideas are born, and where connections are forged. We invite you to step inside, browse our shelves, and become a part of the WoodMart Books story.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/paragraph {"blockId":"9b259844-0652-4e87-a849-3de48700782b","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-9b259844">Thank you for supporting independent bookstores and for sharing our love of books!</p>
<!-- /wp:wd/paragraph --></div>
<!-- /wp:wd/column --></div>
<!-- /wp:wd/row -->]]></content:encoded>
