<h2 class="wp-block-wd-title title wd-16d5ca74 wd-custom-width">At WoodMart, we’re passionate about the tools you carry every day.</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"7eb4917a-8fd0-45de-9846-3dcc44b086e3","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-7eb4917a">At WoodMart, we’re passionate about the tools you carry every day. Whether it’s a sleek knife, a durable flashlight, or a versatile multi-tool, we believe EDC isn’t just about functionality—it’s a way of life.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/button {"blockId":"76b06105-2646-4448-9588-edc0d2fa1356","blockVersion":"2","predefinedColor":"primary","shape":"semi-round"} -->
