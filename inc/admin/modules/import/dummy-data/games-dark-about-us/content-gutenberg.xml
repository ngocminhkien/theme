<h2 class="wp-block-wd-title title wd-322d7ed8">Some of your questions answered here.​</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"53ffd9ef-ddbb-49db-8cec-99dc24c25d87","blockVersion":"2"} -->
<p class="wp-block-wd-paragraph wd-53ffd9ef">We get a lot of questions about our course. You can get any answers in no time here.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/button {"blockId":"755521cd-5332-4b64-a5a0-7b4ab795490a","blockVersion":"2","predefinedColor":"primary","shape":"round"} -->
