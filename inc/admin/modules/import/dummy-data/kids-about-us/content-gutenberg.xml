<div id="wd-e49ab89a" class="wp-block-wd-column"><!-- wp:wd/title {"blockId":"d51c2919-fb88-424d-9221-102ce6881ce4","content":"Some of your questions answered here​","tpFontSize":"32","displayWidth":"","customWidth":"","tpFontSizeTablet":"24","tpFontSizeMobile":"22"} -->
<h2 id="wd-d51c2919" class="wp-block-wd-title title">Some of your questions answered here​</h2>
<!-- /wp:wd/title -->

<!-- wp:wd/paragraph {"blockId":"72a07c14-0d12-40bb-a078-6570f940455f","tpFontSizeMobile":"14"} -->
<p id="wd-72a07c14" class="wp-block-wd-paragraph">We get a lot of questions about our course. You can get any answers.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/button {"blockId":"0685d9bd-7678-4542-ab55-639ec49ad251","predefinedColor":"primary","shape":"semi-round"} -->
