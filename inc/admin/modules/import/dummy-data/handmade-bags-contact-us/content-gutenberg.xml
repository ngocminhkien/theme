<div id="wd-5520b9f3" class="wp-block-wd-row"><!-- wp:wd/column {"blockId":"9ae8f9da-0931-477a-bd2c-42cb6bee88f4","adjacentCount":2,"colWidth":60,"paddingTop":"60","paddingBottom":"60","borderType":"solid","borderColorVariable":"\u002d\u002dwd-alternative-color","borderWidthRight":"1","paddingTopMobile":"40","paddingBottomMobile":"0","borderWidthRightMobile":"0"} -->
<div id="wd-9ae8f9da" class="wp-block-wd-column"><!-- wp:wd/title {"blockId":"db212463-ffd3-4f50-bbe7-430264189ab8","content":"Frequently Asked Questions","tpFontSize":"52","tpLineHeight":"1.2","tpFontSizeTablet":"36","tpFontSizeMobile":"24","tpLineHeightUnits":"em"} -->
<h2 id="wd-db212463" class="wp-block-wd-title title">Frequently Asked Questions</h2>
<!-- /wp:wd/title --></div>
<!-- /wp:wd/column -->

<!-- wp:wd/column {"blockId":"c565b487-42af-4d2e-90d9-554ee4dc4a8a","adjacentCount":2,"colWidth":40,"paddingTop":"40","paddingBottom":"40","paddingTopMobile":"0","paddingBottomMobile":"10"} -->
<div id="wd-c565b487" class="wp-block-wd-column"><!-- wp:wd/accordion {"blockId":"1f2a0660-c2b2-4de5-a6b2-d0db017e916e","allClosed":true,"openerSize":"18","titleTpFontFamily":"var(\u002d\u002dwd-title-font)","titleTpFontSize":"22","titleTpFontVariant":"600","titleTpFontWeight":"600","titlesColorCode":"#333333","titlesHoverColorVariable":"\u002d\u002dwd-primary-color","titlesActiveColorVariable":"\u002d\u002dwd-primary-color","titleTpFontSizeMobile":"18"} -->
<div id="wd-1f2a0660" class="wp-block-wd-accordion wd-accordion wd-style-default wd-titles-start wd-opener-style-arrow wd-opener-pos-end" data-state="all"><!-- wp:wd/accordion-pane {"blockId":"4a7b9cfe-3f14-4bd4-9ae0-d7d922b3f76f","borderWidthTop":"0"} -->
<div id="wd-4a7b9cfe" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>My order hasn't arrived yet. Where is it?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"4426e893-ea9a-432f-a2e9-44205476ae7f"} -->
<p id="wd-4426e893" class="wp-block-wd-paragraph">Keep the product in its original packaging along with all documents confirming the purchase and refund. You will need this for further communication with the seller and the payment system.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane -->

<!-- wp:wd/accordion-pane {"blockId":"9dcc4d16-28ce-4494-b7cc-4507e5fd73b8","borderType":"solid","borderColorVariable":"\u002d\u002dwd-alternative-color","borderWidthTop":"1"} -->
<div id="wd-9dcc4d16" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>Do you deliver on public holidays?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"12871227-dcba-4681-a675-5e6d4087bacd"} -->
<p id="wd-12871227" class="wp-block-wd-paragraph">Check the email you received after placing your order. It should contain information about the status of your order and the expected delivery date.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane -->

<!-- wp:wd/accordion-pane {"blockId":"520ddf96-87f9-422e-8142-b236afe20785","borderType":"solid","borderColorVariable":"\u002d\u002dwd-alternative-color","borderWidthTop":"1"} -->
<div id="wd-520ddf96" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>Do you deliver to my postcode?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"083ba16e-f297-48fe-a217-560a4e07b789"} -->
<p id="wd-083ba16e" class="wp-block-wd-paragraph">If the contents of the parcel are suspicious to customs officers (for example, many identical goods), it may be further checked.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane -->

<!-- wp:wd/accordion-pane {"blockId":"e4a6c093-877d-4a23-b2e5-e9790389b87c","borderType":"solid","borderColorVariable":"\u002d\u002dwd-alternative-color","borderWidthTop":"1"} -->
<div id="wd-e4a6c093" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>Is next-day delivery available on all orders?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"20317f67-f415-4aa5-8fd0-91d8ebcc6055"} -->
<p id="wd-20317f67" class="wp-block-wd-paragraph">If all other options fail, you may need to consider taking legal action. This can be a lengthy and costly process, so it’s important to weigh the potential benefits against the risks and costs.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane -->

<!-- wp:wd/accordion-pane {"blockId":"2610b103-bbee-4be7-994c-82835e200d04","borderType":"solid","borderColorVariable":"\u002d\u002dwd-alternative-color","borderWidthTop":"1"} -->
<div id="wd-2610b103" class="wp-block-wd-accordion-pane wd-accordion-item"><div class="wd-accordion-title"><div class="wd-accordion-title-text"><span>Do I need to be there to sign for delivery?</span></div><span class="wd-accordion-opener"></span></div><div class="wd-accordion-content"><div class="wd-accordion-content-inner"><!-- wp:wd/paragraph {"blockId":"bcc684f8-de70-40c1-a661-1ad5c6e5d25e"} -->
<p id="wd-bcc684f8" class="wp-block-wd-paragraph">Track the status of your order: Woodmart marketplace provides the ability to track the status of an order by tracking number.</p>
<!-- /wp:wd/paragraph --></div></div></div>
<!-- /wp:wd/accordion-pane --></div>
<!-- /wp:wd/accordion --></div>
<!-- /wp:wd/column --></div>
<!-- /wp:wd/row --></div>
<!-- /wp:wd/section -->]]></content:encoded>
