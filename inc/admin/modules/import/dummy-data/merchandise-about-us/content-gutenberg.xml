<!-- wp:wd/accordion {"blockId":"984402e3-7764-4a14-9ca1-0ae0063a5b17","allClosed":true,"openerIcon":"plus","openerSize":"18","titleTpFontSize":"20","titlesHoverColorCode":"#242424","titlesActiveColorCode":"#242424","titleTpFontSizeTablet":"18"} -->
