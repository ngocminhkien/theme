																					<h1>
									My account								</h1>
															<nav><a href="https://dummy.xtemos.com/woodmart2/merchandise-elementor/">Home</a>Page</nav>																		
					<h2>Login</h2>					<form id="customer_login" method="post" action="https://dummy.xtemos.com/woodmart2/merchandise-elementor/my-account/?action=login">
				<p>
					<label for="username">Username or email address&nbsp;*Required</label>
					<input type="text" name="username" id="username" autocomplete="username" value="" />				</p>
				<p>
					<label for="password">Password&nbsp;*Required</label>
					<input type="password" name="password" id="password" autocomplete="current-password" />
				</p>
				<p>
					<input type="hidden" id="woocommerce-login-nonce" name="woocommerce-login-nonce" value="5d4b785da5" /><input type="hidden" name="_wp_http_referer" value="/woodmart2/merchandise-elementor/wp-admin/admin-ajax.php" />										<button type="submit" name="login" value="Log in">Log in</button>
				</p>
				<p>
					<a href="https://dummy.xtemos.com/woodmart2/merchandise-elementor/my-account/lost-password/">Lost your password?</a>
					<label>
						<input name="rememberme" type="checkbox" value="forever" title="Remember me" aria-label="Remember me" /> Remember me
					</label>
				</p>
							</form>
					<h2>Register</h2>]]></content:encoded>
