<!-- wp:wd/paragraph {"blockId":"aa6047d5-be0a-4008-8f9e-ae4eb550915b","textAlign":"center","alignSelf":"center","displayWidth":"custom","customWidth":"330"} -->
<p id="wd-aa6047d5" class="wp-block-wd-paragraph wd-align wd-custom-width wd-align-s-center">Purchase in-store and it’s ready for gifting! Just pick the value of the card.</p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/paragraph {"blockId":"164abd01-06b1-4852-9a78-2dafc50c9b3e","textAlign":"center","colorCode":"#333333"} -->
<p id="wd-164abd01" class="wp-block-wd-paragraph wd-align"><strong>Purchase e-Gift Cards up to €500 in value.</strong></p>
<!-- /wp:wd/paragraph -->

<!-- wp:wd/button {"blockId":"d9f9bcbd-c250-49ba-b897-1cb2e1e02e98","predefinedColor":"primary","shape":"round","icon":"right","alignSelf":"center"} -->
