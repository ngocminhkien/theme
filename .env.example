# =====================================================================
# THEME MARKETPLACE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env trước khi khởi chạy
# =====================================================================

# 1. APP & ENVIRONMENT
NODE_ENV=development
APP_PORT=4000
FRONTEND_PORT=3000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Admin is a separate Next.js application. The backend only allows this
# explicitly configured origin in addition to FRONTEND_URL.
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Storefront links to the separately deployed Admin application. This is a
# public URL, never a JWT/database/payment secret. Set an HTTPS production
# origin (for example https://admin.example.com) in .env.production.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# 2. MYSQL 8.0 DATABASE
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=theme_marketplace
DB_USER=theme_user
DB_PASSWORD=theme_password_secure
DATABASE_URL=mysql://theme_user:theme_password_secure@127.0.0.1:3306/theme_marketplace

# 3. REDIS CACHE & QUEUE
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. JWT & AUTHENTICATION
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# 5. VIETNAMESE PAYMENT (SEPAY / VIETQR AUTOMATION)
# Backend hiện cấu hình webhook SePAY theo phương thức API Key: Authorization: Apikey {SEPAY_API_KEY}.
# Chọn API Key trong dashboard SePAY; không ghi key thật vào repository hoặc client.
SEPAY_API_KEY=your_sepay_api_key_here
# Dành riêng cho cấu hình HMAC tương lai; endpoint hiện không dùng raw-body signature này.
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here
VIETQR_BANK_ACCOUNT=9999999999
VIETQR_BANK_BIN=970422 # Ví dụ: MBBank (970422), Vietcombank (970436)
VIETQR_ACCOUNT_NAME=NGUYEN VAN A

# 6. GLOBAL PAYMENT (STRIPE & PAYPAL)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox # sandbox hoặc live

# 7. ASSET STORAGE (CLOUDFLARE R2 / AWS S3 / LOCAL MINIO FOR THEME ZIPS)
STORAGE_DRIVER=r2 # r2 hoặc s3
# Option A: Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=theme-dist-packages
R2_PUBLIC_DOMAIN=https://assets.yourthemeplatform.com

# Option B: AWS S3 hoặc Local MinIO (docker-compose: http://localhost:9000, console: :9001)
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=theme-dist-packages
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# 8. LICENSE KEY & AUTO-UPDATER
LICENSE_SECRET_SALT=secret_salt_for_license_hash_verification
UPDATER_API_PUBLIC_KEY=your_rsa_public_key_for_client_verification
