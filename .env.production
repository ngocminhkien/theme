# =====================================================================
# THEME MARKETPLACE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# SỬ DỤNG CHO VPS PRODUCTION (UBUNTU 22.04 LTS + DOCKER COMPOSE)
# =====================================================================

# 1. APP & DOMAIN CONFIGURATION
NODE_ENV=production
APP_PORT=4000
FRONTEND_PORT=3000
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# 2. MYSQL 8.0 PRODUCTION DATABASE
DB_HOST=mysql
DB_PORT=3306
DB_NAME=theme_marketplace
DB_USER=theme_user
DB_PASSWORD=SuperStrongProductionPassword_ChangeMe_2026!
DB_ROOT_PASSWORD=SuperStrongRootPassword_ChangeMe_2026!
DATABASE_URL=mysql://theme_user:SuperStrongProductionPassword_ChangeMe_2026!@mysql:3306/theme_marketplace

# 3. REDIS CACHE & QUEUE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. JWT & AUTHENTICATION (BẮT BUỘC ĐỔI KHÓA NGẪU NHIÊN 64 KÝ TỰ)
JWT_SECRET=production_jwt_secret_must_be_at_least_64_characters_random_hex_string_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=production_refresh_secret_must_be_at_least_64_characters_random_hex_string
REFRESH_TOKEN_EXPIRES_IN=30d

# 5. VIETNAMESE PAYMENT (SEPAY / VIETQR AUTOMATION)
SEPAY_API_KEY=prod_sepay_api_key_here
SEPAY_WEBHOOK_SECRET=prod_sepay_webhook_secret_here
VIETQR_BANK_ACCOUNT=9999999999
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NAME=NGUYEN VAN A

# 6. GLOBAL PAYMENT (STRIPE & PAYPAL LIVE MODE)
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_key
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_live_stripe_webhook_secret
PAYPAL_CLIENT_ID=your_live_paypal_client_id
PAYPAL_CLIENT_SECRET=your_live_paypal_client_secret
PAYPAL_MODE=live

# 7. ASSET STORAGE (CLOUDFLARE R2 PRIVATE BUCKET FOR THEME ZIPS)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=theme-dist-packages
R2_PUBLIC_DOMAIN=https://assets.yourdomain.com

# 8. LICENSE KEY & AUTO-UPDATER
LICENSE_SECRET_SALT=production_salt_for_license_hash_verification_2026
UPDATER_API_PUBLIC_KEY=your_rsa_public_key_for_client_verification
